# Copy to .env.server for development, using your isolated database credential.
DATABASE_URL=postgresql://research:CHANGE_ME@127.0.0.1:55461/research
JWT_SECRET=CHANGE_ME
SMTP_HOST=127.0.0.1
SMTP_PORT=11261
SMTP_USERNAME=research
SMTP_PASSWORD=local-mail-only
PRIVATE_STORAGE_PATH=../private-storage
ADMIN_EMAILS=
REGISTRATION_ENABLED=true
# OAuth deliberately disabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# No AI or analytics is enabled, and there are no payment credentials.

# Explicitly disabled until provider, consent and budget have been reviewed.
AI_ENABLED=false
AI_ENDPOINT=
AI_PROVIDER_NAME=
AI_API_KEY=
AI_MODEL=
AI_DAILY_TOKEN_BUDGET=0
AI_MAX_OUTPUT_TOKENS=1500
# Optional exact origin for an operator-approved local HTTP provider.
AI_ALLOWED_HTTP_ORIGIN=
